# Manifest LLM Router
MANIFEST_API_KEY=your_manifest_api_key_here
MANIFEST_BASE_URL=https://api.manifest.build/v1
MANIFEST_MODEL=gpt-4o-mini

# Mem0 Cloud Long-Term Memory
MEM0_API_KEY=your_mem0_api_key_here

# Bot Defaults
DEFAULT_TRIGGER_KEY=!bot
DEFAULT_SYSTEM_PROMPT="You are an intelligent, helpful, and witty group chat participant. Keep your responses concise, conversational, and context-aware."

# Storage paths
SQLITE_DB_PATH=./data/chatbot.db
BAILEYS_AUTH_DIR=./data/baileys_auth
PORT=3000
